# Clave que firma/cifra la cookie de sesión. Mínimo 32 caracteres.
# Genera una con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Modo desarrollo: fuerza la cookie de sesión a NO-secure para que funcione por HTTP
# (IP/dominio sin TLS). En producción con HTTPS déjalo vacío/0.
DEV=1

# Puerto del servidor (opcional). Si no se define, se usa 3071.
# PORT=3071

# --- Producción (VPS) ---
# En el servidor el runtime aplica las claves con prefijo NUXT_:
#   NUXT_SESSION_PASSWORD, NUXT_PUBLIC_APP_NAME.
# Bind solo local: nginx es la única entrada pública (ver skill nginx-expose).
# NITRO_HOST=127.0.0.1
# CAUDAL_DB=/var/www/caudal/data/caudal.db  # BD fuera de current/ (sobrevive redeploys)
# No definas DEV en producción: así la cookie de sesión es Secure (HTTPS).